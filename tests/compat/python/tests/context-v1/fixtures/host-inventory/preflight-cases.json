{
  "cases": [
    {
      "id": "codex-core-missing",
      "host": "codex",
      "inventory": {"plugins": []},
      "doctor": {"supported_protocols": [], "repository_state": null, "issues": []},
      "expected_code": "core_missing",
      "expected_observed": {
        "marketplace": null,
        "plugin": null,
        "source": null,
        "enabled": null,
        "protocol": null,
        "repository_state": null
      },
      "expected_rendered": {
        "code": "core_missing",
        "host": "codex",
        "message": "The exact context-core is absent from the current host inventory.",
        "manual_actions": [
          "Install bobbin@bobbin explicitly from provider marketplace bobbin (source Jeis-Jw/bobbin).",
          "Choose the installation scope explicitly.",
          "Reload the host or start a new session, then run bobbin:init again."
        ]
      }
    },
    {
      "id": "claude-source-mismatch",
      "host": "claude-code",
      "inventory": {
        "plugins": [
          {
            "marketplace": "other-marketplace",
            "plugin": "bobbin",
            "source": "Other/context-core",
            "enabled": true,
            "protocols": ["context-common/v2"]
          }
        ]
      },
      "doctor": {
        "supported_protocols": ["context-common/v2"],
        "repository_state": "ready",
        "issues": []
      },
      "expected_code": "core_source_mismatch",
      "expected_observed": {
        "marketplace": "other-marketplace",
        "plugin": "bobbin",
        "source": "Other/context-core",
        "enabled": true,
        "protocol": "context-common/v2",
        "repository_state": "ready"
      },
      "expected_rendered": {
        "code": "core_source_mismatch",
        "host": "claude-code",
        "message": "A same-named core has a different marketplace or source coordinate.",
        "manual_actions": [
          "Install the exact bobbin@bobbin coordinate from source Jeis-Jw/bobbin explicitly.",
          "A same-named plugin from another marketplace does not satisfy the requirement.",
          "Reload the host or start a new session, then run bobbin:init again."
        ]
      }
    },
